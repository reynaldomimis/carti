<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/llGreeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/btn_notif_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_greeting_main"
                style="@style/CartiSubHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_header_small"
                tools:text="@string/default_greeting" />

            <TextView
                android:id="@+id/tv_username_main"
                style="@style/CartiHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_h2"
                tools:text="@string/user" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="70dp"
                android:layout_height="@dimen/divider_thickness"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="6dp"
                app:dividerColor="@color/border_subtle" />

            <TextView
                android:id="@+id/tv_greeting_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_size_body"
                tools:text="@string/family_label" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btn_notif_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btn_notif"
                android:layout_width="@dimen/icon_size_xl"
                android:layout_height="@dimen/icon_size_xl"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/notifications"
                android:src="@drawable/ic_bell"
                app:tint="@color/text_secondary" />

            <View
                android:id="@+id/notif_badge"
                android:layout_width="@dimen/icon_size_xxs"
                android:layout_height="@dimen/icon_size_xxs"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/badge_dot" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/home"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingBottom="@dimen/bottom_nav_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/viewAiInsight"
                layout="@layout/view_ai_insight" />

            <include
                android:id="@+id/viewBillNotification"
                layout="@layout/view_bill_notification_card" />

            <include
                android:id="@+id/viewFamilyNotification"
                layout="@layout/view_bill_notification_card" />

            <include
                android:id="@+id/viewHomeDashboard"
                layout="@layout/view_home_dashboard" />

            <include
                android:id="@+id/viewHeaderQuickActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                layout="@layout/view_section_header" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvQuickActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_quick_action" />

            <include
                android:id="@+id/viewHeaderQuickLog"
                layout="@layout/view_section_header" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvQuickLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:nestedScrollingEnabled="false"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="4"
                    tools:listitem="@layout/item_quick_log" />

            </FrameLayout>

            <include
                android:id="@+id/viewAiSuggestions"
                layout="@layout/view_ai_suggestions" />

            <include
                android:id="@+id/viewHeaderRecent"
                layout="@layout/view_section_header" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRecentTransactions"
                style="@style/CartiCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTransactions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:scrollbars="none"
                        tools:listitem="@layout/item_transaction" />

                    <TextView
                        android:id="@+id/tvNoTransactions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/spacing_large"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:gravity="center"
                        android:text="@string/no_transactions_yet"
                        android:textColor="@color/text_tertiary"
                        android:textSize="@dimen/text_size_body"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_ios"
    android:orientation="vertical"
    android:padding="@dimen/spacing_large">

    <View
        android:layout_width="@dimen/handle_width"
        android:layout_height="@dimen/handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_large"
        android:background="@drawable/bg_handle_dialog" />

    <TextView
        android:id="@+id/tv_dialog_title"
        style="@style/CartiHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_edit_payday"
        android:textSize="@dimen/text_size_header" />

    <TextView
        style="@style/CartiSubHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="@string/desc_edit_payday"
        android:textSize="@dimen/text_size_body" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_monthly"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        style="@style/CartiSubHeader"
        android:text="@string/label_enable_monthly"
        app:buttonTint="@color/carti_primary_green" />

    <LinearLayout
        android:id="@+id/layout_paydays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/radius_medium"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            style="@style/CartiCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_small">

            <EditText
                android:id="@+id/et_payday1"
                style="@style/CartiEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_standard"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:hint="@string/hint_day1"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:textSize="@dimen/text_size_header" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/CartiCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_small">

            <EditText
                android:id="@+id/et_payday2"
                style="@style/CartiEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_standard"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:hint="@string/hint_day2"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:textSize="@dimen/text_size_header" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save"
        style="@style/CartiButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_standard"
        android:layout_marginTop="@dimen/spacing_large"
        android:text="@string/btn_save_schedule" />

</LinearLayout>

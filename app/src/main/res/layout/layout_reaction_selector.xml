<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/reac_like"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="👍"
            android:textSize="26sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Like" />

        <TextView
            android:id="@+id/reac_love"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="❤️"
            android:textSize="26sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Love" />

        <TextView
            android:id="@+id/reac_haha"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="😂"
            android:textSize="26sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Haha" />

        <TextView
            android:id="@+id/reac_wow"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="😮"
            android:textSize="26sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Wow" />

        <TextView
            android:id="@+id/reac_sad"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="😢"
            android:textSize="26sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sad" />

        <TextView
            android:id="@+id/reac_angry"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="😡"
            android:textSize="26sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Angry" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_duration="1200">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_medium">

        <View
            android:id="@+id/vAvatar"
            android:layout_width="@dimen/spacing_xxl"
            android:layout_height="@dimen/spacing_xxl"
            android:background="@drawable/bg_shimmer_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/vName"
            android:layout_width="@dimen/radius_circle"
            android:layout_height="@dimen/text_size_body"
            android:layout_marginStart="@dimen/radius_medium"
            android:background="@drawable/bg_shimmer_rounded"
            app:layout_constraintStart_toEndOf="@id/vAvatar"
            app:layout_constraintTop_toTopOf="@id/vAvatar" />

        <View
            android:id="@+id/vDesc"
            android:layout_width="160dp"
            android:layout_height="@dimen/text_size_small"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_shimmer_rounded"
            android:alpha="0.6"
            app:layout_constraintStart_toStartOf="@id/vName"
            app:layout_constraintTop_toBottomOf="@id/vName" />

        <View
            android:id="@+id/vAmount"
            android:layout_width="@dimen/avatar_size_medium"
            android:layout_height="@dimen/text_size_header_small"
            android:background="@drawable/bg_shimmer_rounded"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/vAvatar" />

        <View
            android:id="@+id/vDate"
            android:layout_width="80dp"
            android:layout_height="10dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_shimmer_rounded"
            android:alpha="0.4"
            app:layout_constraintStart_toStartOf="@id/vName"
            app:layout_constraintTop_toBottomOf="@id/vDesc" />

        <View
            android:id="@+id/vStatus"
            android:layout_width="70dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_shimmer_rounded"
            android:alpha="0.6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/vDate" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
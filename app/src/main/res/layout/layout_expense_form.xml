<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Balance Allocation Info -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvBalanceInfo"
        style="@style/CartiCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        app:cardBackgroundColor="@color/tonal_button_bg"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/layout_balance_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <TextView
                android:id="@+id/allocatedHeader"
                style="@style/CartiTextDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_budget_plan_allocation" />

            <TextView
                android:id="@+id/tvAllocatedBalance"
                style="@style/CartiTextAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="₱0.00"
                android:textSize="@dimen/text_size_header" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Amount Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAmount"
        style="@style/CartiInputLayout.Amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_amount_peso">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAmount"
            style="@style/CartiEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:paddingVertical="@dimen/spacing_medium" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Description Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDescription"
        style="@style/CartiInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:hint="@string/label_what_bought">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDescription"
            style="@style/CartiEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:paddingVertical="@dimen/spacing_medium" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Payment Source Dropdown -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSource"
        style="@style/CartiInputLayout.Dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:hint="@string/label_payment_source">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/actvSource"
            style="@style/CartiEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:paddingVertical="@dimen/spacing_medium" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>

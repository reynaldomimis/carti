<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <View
            android:layout_width="@dimen/handle_width"
            android:layout_height="@dimen/handle_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_large"
            android:background="@color/border_subtle" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/CartiHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:text="@string/update_goal_title" />

        <!-- Goal Name -->
        <TextView
            style="@style/CartiHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_goal_name"
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGoalName"
            style="@style/CartiInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGoalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:hint="@string/hint_goal_vacation"
                android:inputType="text"
                android:paddingVertical="@dimen/spacing_medium"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body_large" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Target Amount and Date Label -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:orientation="horizontal">

            <TextView
                style="@style/CartiHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_target_amount"
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/text_secondary" />

            <TextView
                style="@style/CartiHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_target_date"
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Target Amount and Date Inputs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTargetAmount"
                style="@style/CartiInputLayout.Amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:hintEnabled="false"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTargetAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:hint="@string/hint_amount_large"
                    android:inputType="numberDecimal"
                    android:paddingVertical="@dimen/spacing_medium"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body_large" />
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="@dimen/spacing_small"
                android:layout_height="0dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTargetDate"
                style="@style/CartiInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:endIconDrawable="@drawable/ic_chevron_right"
                app:endIconMode="custom"
                app:endIconTint="@color/text_tertiary"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTargetDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:hint="@string/hint_date_2025"
                    android:paddingVertical="@dimen/spacing_medium"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body_large" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Family Contribution -->
        <TextView
            style="@style/CartiHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/label_family_contribution"
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/text_secondary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFamilyMembers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:clipToPadding="false"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_member_avatar_select" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateGoal"
            style="@style/CartiButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:enabled="false"
            android:text="@string/btn_update_goal" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardOverview"
    style="@style/DashCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_small"
    app:cardBackgroundColor="@color/tonal_button_bg"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="@dimen/stroke_width_thin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <TextView
            android:id="@+id/tvOverviewTitle"
            style="@style/DashLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_total_balance"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvBalanceAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            tools:text="₱ 150,000.00" />

        <TextView
            android:id="@+id/tvOverviewDate"
            style="@style/DashLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/placeholder_month_year"
            android:textSize="11sp" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/spacing_medium"
            app:dividerColor="@color/border_subtle" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="4dp">

                <!-- Monthly Income -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/radius_medium"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="@dimen/stroke_width_thin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_small">

                        <TextView
                            style="@style/DashLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_monthly_income"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvIncomeAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textColor="@color/green_primary"
                            android:textSize="@dimen/text_size_body_small"
                            tools:text="₱ 120,000" />

                        <TextView
                            android:id="@+id/tvIncomeTrend"
                            style="@style/DashPercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/dash_green"
                            android:textSize="9sp"
                            tools:text="+8% vs last month" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Monthly Expenses -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/radius_medium"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="@dimen/stroke_width_thin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_small">

                        <TextView
                            style="@style/DashLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_monthly_expenses"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvExpensesAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textColor="@color/status_red"
                            android:textSize="@dimen/text_size_body_small"
                            tools:text="₱ 76,100" />

                        <TextView
                            android:id="@+id/tvExpensesTrend"
                            style="@style/DashPercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/dash_red"
                            android:textSize="9sp"
                            tools:text="-12% vs last month" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Net Savings -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/radius_medium"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="@dimen/stroke_width_thin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_small">

                        <TextView
                            style="@style/DashLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_total_savings"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvTotalSavings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textColor="@color/carti_primary_blue"
                            android:textSize="@dimen/text_size_body_small"
                            tools:text="₱ 43,900" />

                        <TextView
                            android:id="@+id/tvSavingsTrend"
                            style="@style/DashPercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/carti_primary_green"
                            android:textSize="9sp"
                            tools:text="+15% vs last month" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

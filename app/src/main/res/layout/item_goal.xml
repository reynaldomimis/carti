<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CartiCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_medium"
    android:layout_marginVertical="@dimen/spacing_xxs">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_medium">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivGoalIcon"
            android:layout_width="@dimen/radius_circle"
            android:layout_height="@dimen/radius_circle"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
            tools:src="@android:drawable/ic_menu_gallery" />

        <TextView
            android:id="@+id/tvGoalTitle"
            style="@style/CartiTextTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivGoalIcon"
            app:layout_constraintTop_toTopOf="@id/ivGoalIcon"
            tools:text="Car Savings" />

        <TextView
            android:id="@+id/tvProgressAmount"
            style="@style/CartiHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxs"
            android:textSize="@dimen/text_size_h1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvGoalTitle"
            app:layout_constraintTop_toBottomOf="@id/tvGoalTitle"
            tools:text="₱3,000 / ₱5,000" />

        <ProgressBar
            android:id="@+id/pbGoal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="@dimen/icon_size_xxs"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginEnd="@dimen/spacing_small"
            android:progress="60"
            android:progressDrawable="@drawable/daily_progress_bar"
            app:layout_constraintEnd_toStartOf="@+id/tvPercent"
            app:layout_constraintStart_toStartOf="@id/tvGoalTitle"
            app:layout_constraintTop_toBottomOf="@id/tvProgressAmount" />

        <TextView
            android:id="@+id/tvPercent"
            style="@style/CartiHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_small"
            app:layout_constraintBottom_toBottomOf="@id/pbGoal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/pbGoal"
            tools:text="60%" />

        <TextView
            android:id="@+id/tvTargetDate"
            style="@style/CartiTextDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textSize="@dimen/text_size_caption"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvGoalTitle"
            app:layout_constraintTop_toBottomOf="@id/pbGoal"
            tools:text="Target: Oct 2024" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
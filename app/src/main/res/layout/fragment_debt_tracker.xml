<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <include
        android:id="@+id/layoutToolbar"
        layout="@layout/layout_custom_toolbar"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_overall_debt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_medium"
        app:cardCornerRadius="@dimen/pill_corner_radius"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <TextView
                android:id="@+id/tv_total_debt_label"
                style="@style/CartiHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_debt_label"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body" />

            <TextView
                android:id="@+id/tv_subtitle"
                style="@style/CartiSubHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debt_summary_subtitle"
                android:textColor="@color/white_80"
                android:textSize="@dimen/text_size_small" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/tv_total_amount"
                    style="@style/CartiHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_display"
                    tools:text="₱2,450.00" />

                <TextView
                    android:id="@+id/tv_overall_percentage"
                    style="@style/CartiHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_pill_white"
                    android:paddingHorizontal="@dimen/radius_medium"
                    android:paddingVertical="@dimen/spacing_xxs"
                    android:textColor="@color/green_budget_status"
                    android:textSize="@dimen/text_size_small"
                    tools:text="15% paid" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tv_progress_description"
                style="@style/CartiSubHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/overall_debt_description"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_small" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_medium"
        app:cardBackgroundColor="@color/surface_variant"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/card_overall_debt"
        app:strokeWidth="0dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_xxl"
            android:background="@android:color/transparent"
            app:tabIndicatorAnimationMode="linear"
            app:tabIndicator="@drawable/bg_pill_white"
            app:tabIndicatorColor="@color/white"
            app:tabIndicatorGravity="center"
            app:tabIndicatorHeight="@dimen/icon_size_xl"
            app:tabIndicatorFullWidth="true"
            app:tabMode="fixed"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/carti_primary_green"
            app:tabTextColor="@color/text_primary"
            app:tabTextAppearance="@style/CartiHeader">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_i_owe" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_owes_me" />

        </com.google.android.material.tabs.TabLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDebts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_small"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabContainer"
        tools:listitem="@layout/item_debt" />

</androidx.constraintlayout.widget.ConstraintLayout>
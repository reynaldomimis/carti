<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <include
        android:id="@+id/layout_toolbar"
        layout="@layout/layout_custom_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/btnSave"
        app:layout_constraintTop_toBottomOf="@id/layout_toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_large"
            android:paddingTop="@dimen/spacing_large"
            android:paddingBottom="@dimen/scroll_bottom_padding">

            <TextView
                style="@style/CartiHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_who_borrowed"
                android:textSize="@dimen/text_size_body" />

            <com.google.android.material.card.MaterialCardView
                style="@style/CartiCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small">

                <EditText
                    android:id="@+id/et_borrower_name"
                    style="@style/CartiEditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height_standard"
                    android:hint="@string/hint_borrower_name"
                    android:inputType="textPersonName"
                    android:importantForAutofill="no" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/CartiHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pill_corner_radius"
                android:text="@string/label_amount_peso"
                android:textSize="@dimen/text_size_body" />

            <com.google.android.material.card.MaterialCardView
                style="@style/CartiCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small">

                <EditText
                    android:id="@+id/et_amount"
                    style="@style/CartiEditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height_standard"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:hint="@string/hint_amount"
                    android:inputType="numberDecimal"
                    android:textSize="@dimen/text_size_header"
                    android:importantForAutofill="no" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/CartiHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pill_corner_radius"
                android:text="@string/label_reason_note"
                android:textSize="@dimen/text_size_body" />

            <com.google.android.material.card.MaterialCardView
                style="@style/CartiCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small">

                <EditText
                    android:id="@+id/et_reason"
                    style="@style/CartiEditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height_standard"
                    android:hint="@string/hint_debt_reason"
                    android:inputType="text"
                    android:importantForAutofill="no" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/CartiHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pill_corner_radius"
                android:text="@string/label_due_date"
                android:textSize="@dimen/text_size_body" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_due_date"
                style="@style/CartiCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_due_date"
                    style="@style/CartiSubHeader"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height_standard"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/spacing_medium"
                    android:text="@string/placeholder_date"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body_large"
                    app:drawableEndCompat="@drawable/ic_calendar"
                    app:drawableTint="@color/text_secondary" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/CartiHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pill_corner_radius"
                android:text="@string/label_is_recurring"
                android:textSize="@dimen/text_size_body" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                app:boxCornerRadiusTopStart="@dimen/radius_medium"
                app:boxStrokeColor="@color/border_subtle"
                app:hintEnabled="false">

                <AutoCompleteTextView
                    android:id="@+id/et_repeat"
                    style="@style/CartiEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/opt_no"
                    android:inputType="text" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        style="@style/CartiButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_standard"
        android:layout_marginHorizontal="@dimen/spacing_large"
        android:layout_marginBottom="@dimen/spacing_large"
        android:text="@string/btn_save_debt"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingHorizontal="@dimen/spacing_medium"
    android:paddingTop="@dimen/spacing_small"
    android:paddingBottom="@dimen/spacing_small">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/back_button_container"
        android:layout_width="@dimen/avatar_size_medium"
        android:layout_height="@dimen/avatar_size_medium"
        android:layout_marginStart="@dimen/spacing_xs"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/surface_variant"
        app:cardCornerRadius="@dimen/radius_medium"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:padding="@dimen/spacing_small"
            android:scaleType="fitXY"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_toolbar_title"
        style="@style/CartiHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_header"
        app:layout_constraintHorizontal_bias="0.45"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/label_title"
        tools:text="@string/goal_title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_action"
        style="@style/CartiButton.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/divider_thickness"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:textSize="@dimen/text_size_small"
        android:visibility="gone"
        app:iconPadding="@dimen/spacing_xs"
        app:iconSize="@dimen/icon_size_xs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/label_action"
        tools:text="@string/btn_add_goal"
        tools:visibility="visible"/>


</androidx.constraintlayout.widget.ConstraintLayout>
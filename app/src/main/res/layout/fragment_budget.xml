<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_xl">

        <include
            android:id="@+id/layoutHeader"
            layout="@layout/view_plan_header" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerBudgets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_small"
            android:layout_marginTop="@dimen/gap_card"
            app:shimmer_auto_start="true">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3">

                <include layout="@layout/item_budget_shimmer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                <include layout="@layout/item_budget_shimmer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                <include layout="@layout/item_budget_shimmer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                <include layout="@layout/item_budget_shimmer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                <include layout="@layout/item_budget_shimmer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                <include layout="@layout/item_budget_shimmer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />

            </GridLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBudgets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_small"
            android:layout_marginTop="@dimen/gap_card"
            android:clipToPadding="false"
            android:visibility="gone"
            android:nestedScrollingEnabled="false"
            tools:itemCount="6"
            tools:listitem="@layout/item_budget_card"
            tools:visibility="visible"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewMoreBudgets"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:text="@string/see_all"
            android:visibility="gone"
            android:textColor="@color/carti_primary_green"
            android:textAllCaps="false"
            app:rippleColor="@color/mint_green_alpha" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEmptyBudgets"
            style="@style/DashCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginVertical="@dimen/spacing_small"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/border_subtle"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chart"
                    app:tint="@color/carti_primary_green" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/CartiHeaderSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/no_budgets_title" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/CartiTextDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/no_budgets_desc"
                    android:textAlignment="center" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="@dimen/gap_section_title">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvCategoriesTitle"
                style="@style/CartiHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/set_up_categories_title"
                app:layout_constraintEnd_toStartOf="@id/btnAddCategory"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvCategoriesDescription"
                style="@style/CartiTextDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/manage_expense_categories_used_for_transactions_and_budgets"
                app:layout_constraintEnd_toStartOf="@id/btnAddCategory"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCategoriesTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddCategory"
                style="@style/CartiButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="@dimen/spacing_medium"
                android:paddingVertical="@dimen/spacing_small"
                android:text="@string/label_add_category_plus"
                app:cornerRadius="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/CartiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/gap_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_category_row" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewMore"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/see_all"
                    android:visibility="gone"
                    android:textColor="@color/carti_primary_green"
                    android:textAllCaps="false"
                    app:rippleColor="@color/mint_green_alpha" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

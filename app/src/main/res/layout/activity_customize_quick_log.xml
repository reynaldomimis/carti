<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <include
        android:id="@+id/layoutToolbar"
        layout="@layout/layout_custom_toolbar" />

    <TextView
        android:id="@+id/tvInstruction"
        style="@style/CartiSubHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_large"
        android:paddingVertical="@dimen/spacing_medium"
        android:text="@string/msg_drag_drop_quick_log"
        android:textSize="@dimen/text_size_body"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCustomize"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingBottom="@dimen/scroll_bottom_padding"
        app:layout_constraintBottom_toTopOf="@id/btnSaveOrder"
        app:layout_constraintTop_toBottomOf="@id/tvInstruction"
        tools:listitem="@layout/item_customize_category" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveOrder"
        style="@style/CartiButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_standard"
        android:layout_marginHorizontal="@dimen/spacing_large"
        android:layout_marginBottom="@dimen/spacing_large"
        android:text="@string/btn_save_order"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

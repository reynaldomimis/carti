<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardBudgetPlan"
    style="@style/DashCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="visible"
    app:cardBackgroundColor="@color/tonal_button_bg"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="@dimen/stroke_width_thin"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <TextView
            style="@style/DashLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_set_budget_plan" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:background="@drawable/bg_pill_white_10"
            android:orientation="vertical"
            android:padding="@dimen/spacing_small">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/add_options_budget_plan"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body_small" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="@string/desc_set_budget_plan"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_xxs" />

            <TextView
                android:id="@+id/btnSetNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/btn_set_now"
                android:textColor="@color/carti_primary_green"
                android:textSize="@dimen/text_size_body"
                android:paddingVertical="@dimen/spacing_xs" />

        </LinearLayout>
        
        <ImageButton
            android:id="@+id/btnCloseBudgetPlan"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            tools:ignore="MissingConstraints" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardBudgetPlan"
    style="@style/DashCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/gap_card"
    app:cardBackgroundColor="@color/tonal_button_bg"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="@dimen/stroke_width_thin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <com.google.android.material.textview.MaterialTextView
            style="@style/DashLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_set_budget_plan" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:background="@drawable/bg_pill_white_10"
            android:orientation="vertical"
            android:padding="@dimen/spacing_small">

            <com.google.android.material.textview.MaterialTextView
                style="@style/CartiHeaderSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_options_budget_plan" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/CartiTextDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:text="@string/desc_set_budget_plan" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/btnSetNow"
                style="@style/CartiHeaderSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/btn_set_now"
                android:textColor="@color/carti_primary_green"
                android:paddingVertical="@dimen/spacing_xs" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

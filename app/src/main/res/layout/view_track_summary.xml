<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_medium">

    <!-- Total Balance Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTotalBalance"
        style="@style/DashCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/tonal_button_bg"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_large">

            <TextView
                android:id="@+id/tvBalanceLabel"
                style="@style/CartiSubHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_total_balance"
                android:textColor="@color/carti_primary_green"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTotalBalance"
                style="@style/CartiTextAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/carti_primary_green"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvBalanceLabel" />

            <LinearLayout
                android:id="@+id/btnViewDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTotalBalance">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:text="@string/label_view"
                    android:textColor="@color/carti_primary_green"
                    android:textSize="@dimen/text_size_caption" />

                <ImageView
                    android:layout_width="@dimen/icon_size_xxs"
                    android:layout_height="@dimen/icon_size_xxs"
                    android:layout_marginStart="@dimen/spacing_xxs"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/carti_primary_green"
                    android:contentDescription="@null" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:src="@drawable/ic_sync"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/carti_primary_green"
                android:alpha="0.2"
                android:contentDescription="@null" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:orientation="horizontal">

        <!-- Monthly Income -->
        <com.google.android.material.card.MaterialCardView
            style="@style/DashCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_small"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/tvSummaryIncomeLabel"
                    style="@style/DashLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_monthly_income" />

                <TextView
                    android:id="@+id/tvSummaryIncome"
                    style="@style/DashAmountSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Monthly Expenses -->
        <com.google.android.material.card.MaterialCardView
            style="@style/DashCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/tvSummaryExpenseLabel"
                    style="@style/DashLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_monthly_expenses" />

                <TextView
                    android:id="@+id/tvSummaryExpense"
                    style="@style/DashAmountSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Savings Progress Card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/DashCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_medium">

            <TextView
                android:id="@+id/tvSavingsLabel"
                style="@style/DashLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/savings_summary_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvSavingsAmount"
                style="@style/DashAmountSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSavingsLabel"
                tools:text="₱40,180 / ₱100,000" />

            <TextView
                android:id="@+id/tvSavingsPercent"
                style="@style/DashPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                app:layout_constraintBottom_toBottomOf="@id/tvSavingsAmount"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvSavingsAmount"
                tools:text="40%" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressSavings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                app:indicatorColor="@color/mint_green"
                app:layout_constraintTop_toBottomOf="@id/tvSavingsAmount"
                app:trackColor="@color/border_subtle"
                app:trackCornerRadius="@dimen/radius_full"
                app:trackThickness="8dp"
                tools:progress="40" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

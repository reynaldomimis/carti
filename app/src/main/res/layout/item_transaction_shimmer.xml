<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_duration="1200">

    <com.google.android.material.card.MaterialCardView
        style="@style/CartiCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_medium"
        android:layout_marginVertical="@dimen/spacing_xs"
        app:cardElevation="0dp"
        app:strokeColor="@color/surface_variant">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_medium">

            <View
                android:id="@+id/vAvatar"
                android:layout_width="@dimen/avatar_size_medium"
                android:layout_height="@dimen/avatar_size_medium"
                android:background="@drawable/bg_shimmer_circle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <View
                android:id="@+id/vTitle"
                android:layout_width="100dp"
                android:layout_height="@dimen/text_size_header_small"
                android:layout_marginStart="@dimen/spacing_medium"
                android:background="@drawable/bg_shimmer_rounded"
                app:layout_constraintStart_toEndOf="@id/vAvatar"
                app:layout_constraintTop_toTopOf="@id/vAvatar"
                app:layout_constraintBottom_toTopOf="@+id/vDesc"
                app:layout_constraintVertical_chainStyle="packed" />

            <View
                android:id="@+id/vDesc"
                android:layout_width="150dp"
                android:layout_height="@dimen/text_size_body_small"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bg_shimmer_rounded"
                android:alpha="0.6"
                app:layout_constraintStart_toStartOf="@id/vTitle"
                app:layout_constraintTop_toBottomOf="@id/vTitle"
                app:layout_constraintBottom_toBottomOf="@id/vAvatar" />

            <View
                android:layout_width="60dp"
                android:layout_height="@dimen/text_size_body"
                android:background="@drawable/bg_shimmer_rounded"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/vTitle" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</com.facebook.shimmer.ShimmerFrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CartiCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_medium"
    android:layout_marginVertical="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_medium">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/avatarContainer"
                android:layout_width="@dimen/spacing_xxl"
                android:layout_height="@dimen/spacing_xxl"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="@dimen/stroke_width_thin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/gray" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvPersonName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/radius_medium"
                android:layout_marginEnd="@dimen/spacing_small"
                style="@style/CartiHeader"
                android:textSize="@dimen/text_size_body_large"
                app:layout_constraintEnd_toStartOf="@+id/tvAmount"
                app:layout_constraintStart_toEndOf="@id/avatarContainer"
                app:layout_constraintTop_toTopOf="@id/avatarContainer"
                tools:text="Ate Liza" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                style="@style/CartiSubHeader"
                android:textSize="@dimen/text_size_body_small"
                app:layout_constraintEnd_toEndOf="@id/tvPersonName"
                app:layout_constraintStart_toStartOf="@id/tvPersonName"
                app:layout_constraintTop_toBottomOf="@id/tvPersonName"
                tools:text="Utang para sa groceries" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                style="@style/CartiSubHeader"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_size_small"
                app:layout_constraintStart_toStartOf="@id/tvPersonName"
                app:layout_constraintTop_toBottomOf="@id/tvDescription"
                tools:text="May 25, 2024" />

            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/CartiHeader"
                android:textSize="@dimen/text_size_header_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/avatarContainer"
                tools:text="₱500" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvDate"
                tools:text="Hindi pa bayad"
                tools:textColor="@color/status_red" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <include
            android:id="@+id/shimmerView"
            layout="@layout/item_debt_shimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />


    </FrameLayout>


</com.google.android.material.card.MaterialCardView>
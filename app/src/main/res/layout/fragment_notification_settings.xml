<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <include
        android:id="@+id/layoutToolbar"
        layout="@layout/layout_custom_toolbar"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <include
                android:id="@+id/headerBudget"
                layout="@layout/layout_settings_header" />

            <include
                android:id="@+id/itemDailyBudget"
                layout="@layout/item_setting_switch" />

            <include
                android:id="@+id/headerSweldo"
                layout="@layout/layout_settings_header" />

            <include
                android:id="@+id/itemSweldoReminder"
                layout="@layout/item_setting_switch" />

            <include
                android:id="@+id/headerOther"
                layout="@layout/layout_settings_header" />

            <include
                android:id="@+id/itemGoalMilestone"
                layout="@layout/item_setting_switch" />

            <include
                android:id="@+id/itemDebtReminders"
                layout="@layout/item_setting_switch" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
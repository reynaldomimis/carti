<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_duration="1200">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_medium">

        <View
            android:id="@+id/vIcon"
            android:layout_width="@dimen/radius_circle"
            android:layout_height="@dimen/radius_circle"
            android:background="@drawable/bg_shimmer_rounded_large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/vTitle"
            android:layout_width="@dimen/scroll_bottom_padding"
            android:layout_height="@dimen/text_size_body"
            android:layout_marginStart="@dimen/spacing_medium"
            android:background="@drawable/bg_shimmer_rounded"
            app:layout_constraintStart_toEndOf="@id/vIcon"
            app:layout_constraintTop_toTopOf="@id/vIcon" />

        <View
            android:id="@+id/vProgressAmount"
            android:layout_width="140dp"
            android:layout_height="@dimen/text_size_header"
            android:layout_marginTop="@dimen/spacing_small"
            android:background="@drawable/bg_shimmer_rounded"
            app:layout_constraintStart_toStartOf="@id/vTitle"
            app:layout_constraintTop_toBottomOf="@id/vTitle" />

        <View
            android:id="@+id/vProgressBar"
            android:layout_width="0dp"
            android:layout_height="@dimen/icon_size_xxs"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginEnd="@dimen/spacing_small"
            android:background="@drawable/bg_shimmer_rounded"
            android:alpha="0.4"
            app:layout_constraintEnd_toStartOf="@+id/vPercent"
            app:layout_constraintStart_toStartOf="@id/vTitle"
            app:layout_constraintTop_toBottomOf="@id/vProgressAmount" />

        <View
            android:id="@+id/vPercent"
            android:layout_width="30dp"
            android:layout_height="@dimen/icon_size_xxs"
            android:background="@drawable/bg_shimmer_rounded"
            android:alpha="0.6"
            app:layout_constraintBottom_toBottomOf="@id/vProgressBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/vProgressBar" />

        <View
            android:id="@+id/vDate"
            android:layout_width="@dimen/radius_circle"
            android:layout_height="@dimen/icon_size_xxs"
            android:layout_marginTop="@dimen/radius_medium"
            android:background="@drawable/bg_shimmer_rounded"
            android:alpha="0.3"
            app:layout_constraintStart_toStartOf="@id/vTitle"
            app:layout_constraintTop_toBottomOf="@id/vProgressBar" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
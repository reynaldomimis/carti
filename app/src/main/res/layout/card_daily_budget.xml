<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/spacing_small"
    app:cardCornerRadius="@dimen/pill_corner_radius"
    app:cardElevation="@dimen/spacing_xxs"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <TextView
            android:id="@+id/tvHeader"
            style="@style/CartiHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/daily_budget"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDate"
            style="@style/CartiSubHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="@string/current_date"
            android:textColor="@color/white_80"
            android:textSize="@dimen/text_size_small"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHeader" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium">

            <TextView
                android:id="@+id/tvAmount"
                style="@style/CartiTextAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tvStatus"
                android:layout_marginEnd="@dimen/spacing_small"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_display"
                tools:text="@string/budget_summary" />

            <TextView
                android:id="@+id/tvStatus"
                style="@style/CartiHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_pill_white"
                android:paddingHorizontal="@dimen/spacing_medium"
                android:paddingVertical="@dimen/spacing_xs"
                android:textColor="@color/green_budget_status"
                android:textSize="@dimen/text_size_body"
                tools:text="@string/amount_remaining" />
        </RelativeLayout>

        <ProgressBar
            android:id="@+id/progressDaily"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/icon_size_xxs"
            android:layout_marginTop="@dimen/spacing_medium"
            android:progress="70"
            android:progressDrawable="@drawable/daily_progress_bar" />

        <TextView
            android:id="@+id/tvSalaryInfo"
            style="@style/CartiSubHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_small"
            tools:text="@string/spent_remaining_days" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ShapeAppearance.Carti.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/card_corner_radius</item>
    </style>

    <style name="ShapeAppearance.Pigy.Circle" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <style name="CartiButton" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/button_height_standard</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Carti.Medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
    </style>

    <style name="CartiButton.Primary">
        <item name="backgroundTint">@color/carti_primary_green</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CartiButton.Tonal">
        <item name="backgroundTint">@color/tonal_button_bg</item>
        <item name="android:textColor">@color/carti_primary_green</item>
    </style>

    <style name="CartiButton.Danger" parent="CartiButton">
        <item name="backgroundTint">@color/status_red_tonal</item>
        <item name="android:textColor">@color/status_red</item>
    </style>

    <style name="CartiHeader">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_header</item>
    </style>

    <style name="CartiSubHeader">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>

    <style name="CartiTextTitle">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_header_small</item>
    </style>

    <style name="CartiTextDescription">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_size_small</item>
    </style>

    <style name="CartiTextBody">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>

    <style name="CartiTextAmount">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_h1</item>
    </style>

    <style name="CartiContainer" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/white</item>
    </style>

    <style name="CartiHeaderContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/white</item>
        <item name="android:paddingHorizontal">@dimen/screen_padding</item>
        <item name="android:paddingTop">@dimen/spacing_medium</item>
        <item name="android:paddingBottom">@dimen/gap_section_title</item>
    </style>

    <style name="CartiRecyclerView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:paddingHorizontal">@dimen/screen_padding</item>
        <item name="android:paddingBottom">@dimen/scroll_bottom_padding</item>
    </style>

    <style name="CartiIconContainer">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="CartiListItemContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">@dimen/spacing_medium</item>
        <item name="android:paddingVertical">@dimen/spacing_small</item>
    </style>

    <style name="CartiHeaderSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>

    <style name="CartiCaption">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/text_size_xxs</item>
    </style>

    <style name="CartiCaption.Primary">
        <item name="android:textColor">@color/green_primary</item>
    </style>

    <style name="CartiCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Carti.Medium</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">@dimen/stroke_width_thin</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="CartiCard.Elevated">
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="CartiInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.Carti.Medium</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="hintTextColor">@color/carti_primary_green</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeErrorColor">@color/status_red</item>
        <item name="boxBackgroundMode">outline</item>
    </style>

    <style name="CartiInputLayout.Filled" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="shapeAppearance">@style/ShapeAppearance.Carti.Medium</item>
        <item name="boxBackgroundColor">@color/tonal_button_bg</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintTextColor">@color/carti_primary_green</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <style name="CartiInputLayout.Amount" parent="CartiInputLayout">
        <item name="prefixText">₱</item>
        <item name="prefixTextColor">@color/text_primary</item>
    </style>

    <style name="CartiInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="shapeAppearance">@style/ShapeAppearance.Carti.Medium</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="hintTextColor">@color/carti_primary_green</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/white</item>
    </style>

    <style name="CartiEditText">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/text_size_body_large</item>
    </style>

    <style name="CartiProgressBar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">@dimen/spacing_small</item>
        <item name="trackCornerRadius">@dimen/radius_medium</item>
    </style>

    <style name="CalendarDayHeader">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">@dimen/spacing_small</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/text_size_xxs</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
    </style>

    <style name="CalendarDayHeader.Dark">
        <item name="android:textColor">@color/bills_text_secondary</item>
    </style>

    <style name="CartiHeader.OnDark">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_header</item>
    </style>

    <style name="CartiSubHeader.OnDark">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textColor">@color/white_60</item>
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>

    <style name="CartiHeader.Dark">
        <item name="android:textColor">@color/bills_text_primary</item>
    </style>

    <style name="DashLabel">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_size_small</item>
    </style>

    <style name="DashAmountLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_h2</item>
    </style>

    <style name="DashAmountSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_header_small</item>
    </style>

    <style name="DashPercentage">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">@dimen/text_size_xxs</item>
    </style>

    <style name="DashCard">
        <item name="cardCornerRadius">@dimen/radius_large</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="CartiSearchBar" parent="Widget.Material3.SearchBar">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:background">@drawable/bg_search_bar_outlined</item>
    </style>

    <style name="CartiDatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/carti_primary_green</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurface">@color/white</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Carti.Medium</item>
    </style>

    <style name="CartiTabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/carti_primary_green</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabSelectedTextColor">@color/carti_primary_green</item>
        <item name="tabTextColor">@color/text_secondary</item>
        <item name="tabIconTint">@color/selector_tab_icon</item>
        <item name="tabRippleColor">@color/mint_green_alpha</item>
        <item name="tabTextAppearance">@style/CartiTabTextAppearance</item>
        <item name="android:paddingHorizontal">0dp</item>
    </style>

    <style name="CartiTabTextAppearance" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TransparentBottomSheetDialog" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/TransparentBottomSheetStyle</item>
    </style>

    <style name="TransparentBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ShapeAppearance.Pigy.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CartiButton" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/button_height_standard</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
    </style>

    <style name="CartiButton.Primary">
        <item name="backgroundTint">@color/carti_primary_green</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CartiButton.Tonal">
        <item name="backgroundTint">@color/tonal_button_bg</item>
        <item name="android:textColor">@color/carti_primary_green</item>
    </style>

    <style name="CartiButton.Danger" parent="CartiButton">
        <item name="backgroundTint">@color/status_red_tonal</item>
        <item name="android:textColor">@color/status_red</item>
    </style>

    <style name="CartiHeader">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_header</item>
    </style>

    <style name="CartiSubHeader">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>

    <style name="CartiTextTitle">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_header_small</item>
    </style>

    <style name="CartiTextDescription">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_size_body_small</item>
    </style>

    <style name="CartiTextAmount">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_h1</item>
    </style>

    <style name="CartiCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">@dimen/stroke_width_thin</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="CartiCard.Elevated">
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="CartiEditText">
        <item name="android:layout_height">@dimen/input_height_standard</item>
        <item name="android:paddingHorizontal">@dimen/spacing_medium</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/text_size_body_large</item>
    </style>

    <style name="CartiProgressBar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">@dimen/spacing_small</item>
        <item name="trackCornerRadius">@dimen/radius_medium</item>
    </style>

</resources>
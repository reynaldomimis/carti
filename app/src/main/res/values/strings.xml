    <!-- Help & FAQ -->
    <string name="section_faq">Frequently Asked Questions</string>
    <string name="faq_q1">How do I add a family member?</string>
    <string name="faq_a1">Go to Profile > Invite Family and share the unique code with them.</string>
    <string name="faq_q2">What is Salary Mode?</string>
    <string name="faq_a2">Salary Mode helps you manage expenses between paydays by calculating your remaining daily budget.</string>
    <string name="faq_q3">Can I delete my account?</string>
    <string name="faq_a3">Yes, you can permanently delete your account and all associated data in Profile > Security > Delete Account.</string>
    <string name="faq_q4">Can I sign out from other devices?</string>
    <string name="faq_a4">Yes, go to Profile > Security and select "Sign out from all devices" to secure your account.</string>
    <string name="faq_q5">Is my data safe and private?</string>
    <string name="faq_a5">Absolutely. We use industry-standard encryption and Appwrite\'s secure infrastructure to protect your financial data. We do not sell your personal information.</string>
    <string name="faq_q6">Who can see my expenses?</string>
    <string name="faq_a6">Only members of your specific family group can see the shared wallet transactions. Your account credentials and private settings are never shared.</string>
    <string name="faq_q7">How do I request data deletion?</string>
    <string name="faq_a7">You can delete your entire account and all associated data directly from the Security settings. This process is immediate and irreversible.</string>
    <string name="faq_q8">Does Carti share my data with third parties?</string>
    <string name="faq_a8">No. Your financial data is strictly used for your family\'s tracking purposes. We do not share or sell your data to advertisers or third-party services.</string>
